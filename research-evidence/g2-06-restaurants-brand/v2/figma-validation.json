{
  "pageId": "20:2",
  "pageName": "G2.06 · Proposals v2 · Open kitchen family · Not final branding",
  "directionDeclarations": [
    {
      "id": "20:52",
      "characters": "Plato, pera, berenjena y taza son cuatro ejemplos. Repertorio abierto a comida, cocina y restaurante, con un lenguaje visual compartido."
    },
    {
      "id": "20:56",
      "characters": "Idea de dirección, no branding definitivo. Personajes, colores y detalles exploratorios; el repertorio no se limita a estos cuatro ejemplos."
    },
    {
      "id": "20:107",
      "characters": "Cualquier elemento de comida, cocina o restaurante puede entrar en la familia. Estos cuatro son muestras; silueta, gesto y expresión conservan parentesco."
    },
    {
      "id": "20:108",
      "characters": "Idea de dirección, no familia final. Anatomía y detalles se ajustarán después. Los personajes no indican dieta, disponibilidad ni alérgenos. G2.08 desarrolla producción."
    },
    {
      "id": "20:166",
      "characters": "Paleta, lettering y fuentes exploratorios: no branding definitivo. OFL conservadas; binarios de Figma no identificados. Producción y ajuste óptico posteriores."
    }
  ],
